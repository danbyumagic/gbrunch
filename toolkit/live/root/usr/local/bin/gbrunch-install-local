#!/bin/bash
set -euo pipefail
work=$(findmnt -nr -S LABEL=GBWORK -o TARGET | head -n1)
[ -n "$work" ] || { echo 'Initialize USB storage and reboot first.'; read -r; exit 1; }
mkdir -p "$work/logs"
python3 -u /opt/gbrunch/source/toolbox_install.py 2>&1 | tee "$work/logs/install-console-$(date -u +%Y%m%d-%H%M%S).log"
