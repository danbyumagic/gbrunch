@@ -2659,6 +2659,115 @@ void helper_sha256msg2(Reg *d, Reg *a, Reg *b)
 }
 #endif
 
+#if SHIFT >= 1
+/* GBRUNCH experimental GFNI emulation: no Google guest code changes. */
+
+static void glue(gbrunch_vnni, SUFFIX)(Reg *d, Reg *v, Reg *s,
+                                      bool words, bool saturate)
+{
+    Reg dd = *d, vv = *v, ss = *s;
+    for (int i = 0; i < (2 << SHIFT); i++) {
+        int64_t sum = (int32_t)dd.L(i);
+        if (words) {
+            for (int j = 0; j < 2; j++) {
+                sum += (int64_t)(int16_t)vv.W(2*i+j) * (int16_t)ss.W(2*i+j);
+            }
+        } else {
+            for (int j = 0; j < 4; j++) {
+                sum += (int64_t)vv.B(4*i+j) * (int8_t)ss.B(4*i+j);
+            }
+        }
+        if (saturate) {
+            sum = MIN(MAX(sum, INT32_MIN), INT32_MAX);
+        }
+        d->L(i) = (uint32_t)sum;
+    }
+}
+void glue(helper_vpdpbusd, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
+{
+    glue(gbrunch_vnni, SUFFIX)(d, v, s, false, false);
+}
+void glue(helper_vpdpbusds, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
+{
+    glue(gbrunch_vnni, SUFFIX)(d, v, s, false, true);
+}
+void glue(helper_vpdpwssd, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
+{
+    glue(gbrunch_vnni, SUFFIX)(d, v, s, true, false);
+}
+void glue(helper_vpdpwssds, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
+{
+    glue(gbrunch_vnni, SUFFIX)(d, v, s, true, true);
+}
+
+static uint8_t glue(gbrunch_gf_mul, SUFFIX)(uint8_t a, uint8_t b)
+{
+    uint8_t result = 0;
+    for (int i = 0; i < 8; i++) {
+        if (b & 1) {
+            result ^= a;
+        }
+        a = (a << 1) ^ ((a & 0x80) ? 0x1b : 0);
+        b >>= 1;
+    }
+    return result;
+}
+
+static uint8_t glue(gbrunch_gf_inv, SUFFIX)(uint8_t a)
+{
+    uint8_t result = 1;
+    unsigned exponent = 254;
+    while (exponent) {
+        if (exponent & 1) {
+            result = glue(gbrunch_gf_mul, SUFFIX)(result, a);
+        }
+        a = glue(gbrunch_gf_mul, SUFFIX)(a, a);
+        exponent >>= 1;
+    }
+    return result;
+}
+
+void glue(helper_gf2p8mulb, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s)
+{
+    Reg vv = *v, ss = *s;
+    for (int i = 0; i < (8 << SHIFT); i++) {
+        d->B(i) = glue(gbrunch_gf_mul, SUFFIX)(vv.B(i), ss.B(i));
+    }
+}
+
+static void glue(gbrunch_gf_affine, SUFFIX)(Reg *d, Reg *v, Reg *s,
+                                         uint32_t immediate, bool inverse)
+{
+    Reg vv = *v, ss = *s;
+    for (int i = 0; i < (8 << SHIFT); i++) {
+        uint8_t x = vv.B(i), result = immediate;
+        if (inverse) {
+            x = glue(gbrunch_gf_inv, SUFFIX)(x);
+        }
+        for (int bit = 0; bit < 8; bit++) {
+            uint8_t row = ss.B((i & ~7) + 7 - bit) & x;
+            row ^= row >> 4;
+            row ^= row >> 2;
+            row ^= row >> 1;
+            result ^= (row & 1) << bit;
+        }
+        d->B(i) = result;
+    }
+}
+
+void glue(helper_gf2p8affineqb, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s,
+                                     uint32_t immediate)
+{
+    glue(gbrunch_gf_affine, SUFFIX)(d, v, s, immediate, false);
+}
+
+void glue(helper_gf2p8affineinvqb, SUFFIX)(CPUX86State *env, Reg *d, Reg *v, Reg *s,
+                                        uint32_t immediate)
+{
+    glue(gbrunch_gf_affine, SUFFIX)(d, v, s, immediate, true);
+}
+#endif
+
 #undef SSE_HELPER_S
 
 #undef LANE_WIDTH
